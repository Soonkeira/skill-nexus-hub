# Database
DB_PASSWORD=your_secure_db_password_here

# Backend
# When ENV=production the backend refuses to start while SECRET_KEY is left
# unchanged (fail-fast guard in backend/app/config.py) — always change it.
SECRET_KEY=your_random_secret_key_at_least_32_chars
CORS_ORIGINS=http://localhost:9527
DATABASE_URL=postgresql+asyncpg://skillhub:your_secure_db_password_here@postgres:5432/skill_nexus_hub
TRUSTED_PROXIES=172.18.0.1,10.0.0.1

# Environment: dev or production
ENV=production
